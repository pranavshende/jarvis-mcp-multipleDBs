{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JarvisMCPToolsSpecification",
  "description": "Formal contract definition for all Model Context Protocol (MCP) tools in Jarvis v1",
  "version": "1.0.0",
  "definitions": {
    "CallerContext": {
      "type": "object",
      "properties": {
        "caller_id": {
          "type": "string",
          "description": "Authenticated Employee ID (e.g. EMP-001)"
        },
        "role": {
          "type": "string",
          "enum": [
            "ROLE_FOUNDER",
            "ROLE_FINANCE",
            "ROLE_OPS_LEAD",
            "ROLE_WH_MGR",
            "ROLE_SUPPORT",
            "ROLE_SALES",
            "ROLE_CONTRACTOR",
            "ROLE_SYSTEM"
          ]
        },
        "facility_scope": {
          "type": "string",
          "enum": [
            "ALL",
            "FAC-01",
            "FAC-02"
          ],
          "default": "ALL"
        },
        "client_channel": {
          "type": "string",
          "enum": [
            "SLACK_SOCKET",
            "MCP_STREAMABLE_HTTP",
            "MCP_STDIO",
            "ADMIN_UI"
          ]
        }
      },
      "required": [
        "caller_id",
        "role",
        "client_channel"
      ]
    }
  },
  "tools": [
    {
      "name": "execute_metric",
      "description": "Execute a pre-compiled, deterministic business metric query against the analytics replica. Never executes free-form SQL.",
      "parameters": {
        "type": "object",
        "properties": {
          "metric_id": {
            "type": "string",
            "enum": [
              "DAILY_PACKAGES_RECEIVED",
              "NET_PROFIT_GAAP",
              "BLOCKED_PAYOUTS_TOTAL",
              "PARTNER_CREDIT_UTILIZATION",
              "INVENTORY_HOLDING_RISK",
              "INBOUND_QUALITY_RATE",
              "MEMBER_PAYOUT_VELOCITY",
              "FULFILLMENT_FILL_RATE"
            ],
            "description": "Registered identifier of the business metric"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "format": "date",
                "description": "Single date (YYYY-MM-DD)"
              },
              "start_date": {
                "type": "string",
                "format": "date"
              },
              "end_date": {
                "type": "string",
                "format": "date"
              },
              "facility_code": {
                "type": "string",
                "enum": [
                  "ALL",
                  "FAC-01",
                  "FAC-02"
                ]
              },
              "partner_id": {
                "type": "string"
              },
              "canonical_sku": {
                "type": "string"
              }
            }
          },
          "caller_context": {
            "$ref": "#/definitions/CallerContext"
          }
        },
        "required": [
          "metric_id",
          "caller_context"
        ]
      }
    },
    {
      "name": "search_company_knowledge",
      "description": "Hybrid semantic vector and BM25 keyword search across approved company documentation, SOPs, policies, and verified meeting decisions.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500,
            "description": "Search query or question"
          },
          "scope": {
            "type": "string",
            "enum": [
              "ALL",
              "SOP_PUBLIC",
              "OPERATIONS_INTERNAL",
              "FINANCE_EXECUTIVE",
              "LEGAL_COMPLIANCE"
            ],
            "default": "SOP_PUBLIC"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 5
          },
          "caller_context": {
            "$ref": "#/definitions/CallerContext"
          }
        },
        "required": [
          "query",
          "caller_context"
        ]
      }
    },
    {
      "name": "get_active_alerts",
      "description": "Retrieve prioritized operational and financial anomalies generated by the background rules engine.",
      "parameters": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "ALL",
              "FINANCIAL",
              "OPERATIONAL",
              "CREDIT_RISK",
              "INVENTORY"
            ],
            "default": "ALL"
          },
          "min_severity": {
            "type": "string",
            "enum": [
              "INFO",
              "WARNING",
              "CRITICAL"
            ],
            "default": "WARNING"
          },
          "caller_context": {
            "$ref": "#/definitions/CallerContext"
          }
        },
        "required": [
          "caller_context"
        ]
      }
    },
    {
      "name": "request_action_execution",
      "description": "Submit a proposed mutating action to the Restricted Action Service for dual-signature approval. Does NOT execute directly.",
      "parameters": {
        "type": "object",
        "properties": {
          "action_type": {
            "type": "string",
            "enum": [
              "OVERRIDE_CREDIT_LIMIT",
              "TRIGGER_PAYOUT_BATCH_RESUBMIT",
              "UPDATE_BUY_LIST_SPREAD",
              "QUARANTINE_DAMAGED_INVENTORY"
            ]
          },
          "target_entity_id": {
            "type": "string",
            "description": "e.g. PTR-1004 or BATCH-20261012"
          },
          "payload": {
            "type": "object"
          },
          "justification": {
            "type": "string",
            "minLength": 15
          },
          "caller_context": {
            "$ref": "#/definitions/CallerContext"
          }
        },
        "required": [
          "action_type",
          "target_entity_id",
          "justification",
          "caller_context"
        ]
      }
    }
  ]
}